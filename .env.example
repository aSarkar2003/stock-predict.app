PGPASSWORD_RO=app_ro_pass

# Application Config
JWT_SECRET=super-secret-jwt-key-for-stock-predict-application-dev
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=development

